{
  "name": "my-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "husky",
    "test": "npm run test:coverage",
    "test:coverage": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.nyc_output', { recursive: true, force: true });\" && npm run test:component && npm run test:e2e && nyc report --check-coverage --statements 80 --branches 80 --functions 80 --lines 80",
    "test:component": "cross-env CYPRESS_COVERAGE=true cypress run --component",
    "test:e2e": "cross-env CYPRESS_COVERAGE=true start-server-and-test \"npm run dev -- --host 127.0.0.1 --port 4174 --strictPort\" http://127.0.0.1:4174 \"cypress run --e2e\"",
    "cypress:open:component": "cross-env CYPRESS_COVERAGE=true cypress open --component",
    "cypress:open:e2e": "cross-env CYPRESS_COVERAGE=true start-server-and-test \"npm run dev -- --host 127.0.0.1 --port 4174 --strictPort\" http://127.0.0.1:4174 \"cypress open --e2e\"",
    "coverage:report": "nyc report --reporter=text-summary --reporter=html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.{js,jsx}"
    ],
    "extension": [
      ".js",
      ".jsx"
    ],
    "reporter": [
      "text-summary",
      "html"
    ]
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.8",
    "start-server-and-test": "^2.1.5",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
